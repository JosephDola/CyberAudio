{
  "schemaVersion": 1,
  "id": "cyberaudio",
  "version": "${version}",
  "name": "CyberAudio",
  "description": "Minecraft-native audio player with persistent playlists, direct streams, and optional YouTube/Spotify embeds through MCEF.",
  "authors": ["JosephDola"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "main": ["com.cybertron.cyberaudio.CyberAudio"],
    "client": ["com.cybertron.cyberaudio.client.CyberAudioClient"]
  },
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "mcef": "*"
  }
}
